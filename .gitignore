# Reference material (~12 GB): decomp sources, HD texture pack, builder.
# Third-party and far too large to track. Fetch these yourself and point the
# converters at them; nothing here is required to read or review the code.
/reference/

# Converted level data. Regenerate with tools/parse_collision.py and
# tools/parse_f3d.py -- these are derived from reference/, so they are build
# output rather than source.
/assets/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Panda3D / runtime output
*.bam
*.prc.local
panda3d.log
screenshots/
# Panda3D's default screenshot naming, rather than a blanket *.png -- that
# would silently swallow any image you actually meant to commit.
screenshot-*.png
screenshot-*.jpg
*-screenshot-*.png

# Profiling
*.prof
*.lprof

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Personal Claude Code settings. .claude/settings.json is deliberately left
# tracked, since project permissions are usually meant to be shared.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini
