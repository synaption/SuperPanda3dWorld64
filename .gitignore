# Reference material (~12 GB): decomp sources, HD texture pack, builder.
# Third-party and far too large to track. Fetch these yourself and point the
# converters at them; nothing here is required to read or review the code.
/reference/

# assets/ IS tracked -- see README, "Assets". It holds only what the game
# actually loads (~23 MB, of which the generated planet's glTF is 14), so a
# clone runs without the 12 GB of reference material. Everything in it except
# the planet is derived from Nintendo's game data; see the note there before
# publishing this repository anywhere.
#
# Converter scratch that is not loaded at runtime:
/assets/**/*.tmp
/assets/**/*.bak

# Blender's own backup of the file it last saved. Written automatically beside
# every .blend, identical to the previous save, and worth 67 MB of history for
# nothing: the .blend beside it is the source of truth and git holds its
# history.
*.blend1

# What tools/build_assets.py last built, and out of what. Machine-local by
# definition -- a clone that has never built an asset is supposed to arrive
# without one and rebuild everything the first time.
/.build_assets.json

# Rust / Cargo build trees, including nested experimental crates. Cargo.lock IS
# tracked -- this is a binary, not a library, and a reproducible build is worth
# more here than floating dependency versions.
**/target/

# Packaged builds produced by build_windows.sh.
/dist/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Runtime output
screenshots/
screenshot-*.png
screenshot-*.jpg
*-screenshot-*.png

# Profiling
*.prof
*.lprof

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Personal Claude Code settings. .claude/settings.json is deliberately left
# tracked, since project permissions are usually meant to be shared.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini

*.exe

blender-5.2.0-linux-x64/*
# Third-party material libraries and downloaded tooling, cloned or fetched into
# the tree by hand. Large, and none of it is the game: the pipeline is pointed
# at them, they are not built from here.
/cc0-textures/
/tools_local/
*.log
