# Reference material (~12 GB): decomp sources, HD texture pack, builder.
# Third-party and far too large to track. Fetch these yourself and point the
# converters at them; nothing here is required to read or review the code.
/reference/

# assets/ IS tracked -- see README, "Assets". It holds only what the game
# actually loads (~8.5 MB), so a clone runs without the 12 GB of reference
# material. Everything in it is derived from Nintendo's game data; see the
# note there before publishing this repository anywhere.
#
# Converter scratch that is not loaded at runtime:
/assets/**/*.tmp
/assets/**/*.bak

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Panda3D / runtime output
*.bam
*.prc.local
panda3d.log
screenshots/
# Panda3D's default screenshot naming, rather than a blanket *.png -- that
# would silently swallow any image you actually meant to commit.
screenshot-*.png
screenshot-*.jpg
*-screenshot-*.png

# Profiling
*.prof
*.lprof

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Personal Claude Code settings. .claude/settings.json is deliberately left
# tracked, since project permissions are usually meant to be shared.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini
